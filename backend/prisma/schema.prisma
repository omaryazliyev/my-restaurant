generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// USER & AUTH
// ============================
model User {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String        @unique
  username     String        @unique
  password     String        // hash
  role         Role          @default(CLIENT)
  createdAt    DateTime      @default(now())

  reservations Reservation[]
  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
}

enum Role {
  CLIENT
  ADMIN
}

// ============================
// TABLES / SEATS (Bronlash uchun)
// ============================
model Table {
  id           Int           @id @default(autoincrement())
  number       String        // masalan "A1", "VIP-2"
  capacity     Int
  location     String?       // "oyna yonida" va h.k.

  reservations Reservation[]
}

model Reservation {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  tableId   Int
  table     Table    @relation(fields: [tableId], references: [id])

  phone     String
  guests    Int
  date      DateTime   // faqat sana qismi
  startTime DateTime   // shu kun ichidagi vaqt (soat)
  status    ReservationStatus @default(PENDING)
  createdAt DateTime @default(now())

  // MUHIM: bitta stol bir kunda bir necha marta bron qilinishi mumkin,
  // lekin bir xil sana+vaqtda ikki marta bo'lmasligi kerak
  @@unique([tableId, date, startTime])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ============================
// MENU
// ============================
model Category {
  id    Int        @id @default(autoincrement())
  name  String     @unique // "Первые", "Вторые", "Фаст-Фуд"
  items MenuItem[]
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  price       Decimal
  image       String
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])

  reviews     Review[]
  favorites   Favorite[]
  orderItems  OrderItem[]
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
}

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
}

// ============================
// ORDERS / CHECKOUT
// ============================
model Order {
  id             Int             @id @default(autoincrement())
  userId         Int
  user           User            @relation(fields: [userId], references: [id])

  deliveryMethod DeliveryMethod
  address        String?         // faqat "manzilga yetkazish" bo'lsa
  paymentMethod  PaymentMethod
  status         OrderStatus     @default(PENDING)
  totalPrice     Decimal
  createdAt      DateTime        @default(now())

  items          OrderItem[]
}

enum DeliveryMethod {
  PICKUP        // Olib ketish
  DOOR_DELIVERY // Eshikkacha
  ADDRESS       // Manzilga (xarita)
}

enum PaymentMethod {
  ONLINE_CARD
  CASH_ON_DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])
  menuItemId   Int
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  quantity     Int
  priceAtOrder Decimal  // buyurtma paytidagi narx (keyinchalik narx o'zgarsa ham tarix saqlanadi)
}

// ============================
// CONTACT FORM
// ============================
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
}
